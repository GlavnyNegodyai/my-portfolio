---
import Layout from '../../layouts/Layout.astro';
import TabList from '../../components/tab-list/tab-list';
import content from "../../i18n/ru.json";
import Header from "../../components/header/header";
import Footer from "../../components/footer/footer";
---

<Layout>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{content.title}</title>
	</head>
	<body class="window active">
		<Header content={content.header} currLang={content.lang} resumeLang={content.lang} client:load/>
		<main class="window-body has-space">
    		<TabList content={content} resumeLang={content.lang} client:load></TabList>
		</main>
		<Footer/>
	</body>
</Layout>

